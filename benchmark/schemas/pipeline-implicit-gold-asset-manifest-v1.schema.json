          "const": "Operation-FileOperate-BatchOperationExcel-008"
        },
        "task_uid": {
          "const": "1c73128f-a5ef-4a97-97ce-ef427d6d46b4"
        },
        "source": {
          "type": "object",
          "properties": {
            "base_path": {
              "const": "answer_files/1c73128f-a5ef-4a97-97ce-ef427d6d46b4"
            }
          }
        },
        "entries": {
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            }
          }
        }
      }
    },
    {
      "required": ["manifest_id", "task_id", "task_uid", "source", "entries"],
      "properties": {
        "manifest_id": {
          "const": "Operation-FileOperate-BatchOperationPPT-003-gold-v1"
        },
        "task_id": {
          "const": "Operation-FileOperate-BatchOperationPPT-003"
        },
        "task_uid": {
          "const": "e544ee0f-90e6-43a4-9958-6b74e88d94a6"
        },
        "source": {
          "type": "object",
          "properties": {
            "base_path": {
              "const": "answer_files/e544ee0f-90e6-43a4-9958-6b74e88d94a6"
            }
          }
        },
        "entries": {
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "enum": [
                  "image/jpeg",
                  "application/vnd.openxmlformats-officedocument.presentationml.presentation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "required": ["manifest_id", "task_id", "task_uid", "source", "entries"],
      "properties": {
        "manifest_id": {
          "const": "Operation-FileOperate-SearchAndWrite-008-gold-v1"
