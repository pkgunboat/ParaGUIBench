    },
    "task_uid": {
      "enum": [
        "1c73128f-a5ef-4a97-97ce-ef427d6d46b4",
        "e544ee0f-90e6-43a4-9958-6b74e88d94a6",
        "65a4848d-b4b2-4173-8308-a0213fdafbd0"
