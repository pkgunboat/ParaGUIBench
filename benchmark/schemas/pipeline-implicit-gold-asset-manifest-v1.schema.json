  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "revision", "base_path"],
      "properties": {
        "provider": {"const": "huggingface_dataset"},
        "repository": {"const": "leeLegendary/Parallel_benchmark"},
        "revision": {
          "const": "13bf942dfab6f9d71f16f0958f1edd8b436c7afa"
        },
        "base_path": {
          "enum": [
            "answer_files/1c73128f-a5ef-4a97-97ce-ef427d6d46b4",
            "answer_files/e544ee0f-90e6-43a4-9958-6b74e88d94a6",
            "answer_files/65a4848d-b4b2-4173-8308-a0213fdafbd0"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "spdx_expression",
        "evidence_ref",
        "distribution"
