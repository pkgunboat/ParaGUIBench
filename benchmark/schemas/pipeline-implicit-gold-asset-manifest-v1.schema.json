    "manifest_role": {"const": "gold"},
    "source": {"$ref": "#/$defs/source"},
    "license": {"$ref": "#/$defs/license"},
    "distribution_policy": {"const": "download_only"},
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
