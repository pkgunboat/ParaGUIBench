    "manifest_id": {
      "enum": [
        "Operation-FileOperate-BatchOperationExcel-008-gold-v1",
        "Operation-FileOperate-BatchOperationPPT-003-gold-v1",
        "Operation-FileOperate-SearchAndWrite-008-gold-v1"
