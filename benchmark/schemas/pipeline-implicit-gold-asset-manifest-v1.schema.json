              "const": "answer_files/65a4848d-b4b2-4173-8308-a0213fdafbd0"
            }
          }
        },
        "entries": {
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "media_type": {
                "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            }
          }
        }
      }
    }
