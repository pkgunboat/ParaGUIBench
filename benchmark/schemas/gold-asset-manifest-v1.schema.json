{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkgunboat.github.io/ParaGUIBench/schemas/gold-asset-manifest-v1.schema.json",
  "title": "ParaGUIBench pinned evaluator gold asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "distribution_policy",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "distribution_policy": {
      "const": "download_only"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_key",
        "source_locator",
        "runtime_locator",
        "size",
        "sha256",
        "media_type",
        "license",
        "provenance"
      ],
      "properties": {
        "logical_key": {
          "type": "string",
          "pattern": "^osworld-gold:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:expected:(0|[1-9][0-9]*):v1$"
        },
        "source_locator": {
          "$ref": "#/$defs/source_locator"
        },
        "runtime_locator": {
          "$ref": "#/$defs/runtime_locator"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/x-bibtex",
            "application/zip",
            "image/png",
            "text/csv"
          ]
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "revision",
        "path"
      ],
      "properties": {
        "provider": {
          "const": "huggingface_dataset"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
        }
      }
    },
    "runtime_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "cache-relative-path"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?#\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "spdx_expression",
        "evidence_ref",
        "distribution"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "author-provided",
            "unverified"
          ]
        },
        "spdx_expression": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "distribution": {
          "const": "download_only"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_benchmark",
        "source_task_id",
        "source_evaluator_id",
        "expected_index",
        "source_contract_sha256",
        "evidence_ref"
      ],
      "properties": {
        "source_benchmark": {
          "const": "OSWorld"
        },
        "source_task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_evaluator_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "source_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^osworld:evaluator:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:expected:(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
